---
import Base from "../../layouts/Base.astro";
import { autoresBuild, indexBuild } from "../../lib/datosBuild";
import { slugObra, slugificar } from "../../lib/slugs";
import { minutoLegible, enlaceYoutube } from "../../lib/datos";

export function getStaticPaths() {
  return autoresBuild().map((a) => ({
    params: { slug: slugificar(a.autor) },
    props: { autor: a },
  }));
}

const { autor } = Astro.props;
const index = indexBuild();
const episodios = autor.episodios.map((id) => index.eps.find((e) => e[0] === id)).filter(Boolean);

const descripcion = `${autor.autor}: ${autor.menciones} menciones en Punzadas Sonoras, entre ${autor.episodios.length} episodios` +
  (autor.primera_aparicion ? `, desde ${autor.primera_aparicion}.` : ".");
---

<Base titulo={autor.autor} descripcion={descripcion}>
  <div class="envoltura" style="max-width: 42rem; padding-block: var(--space-section);">
    <h1>{autor.autor}</h1>
    <p style="color: var(--color-texto-tenue);">
      {autor.menciones} menciones · {autor.obras.length} obras · {episodios.length} episodios
      {autor.primera_aparicion && ` · de ${autor.primera_aparicion} a ${autor.ultima_aparicion}`}
    </p>

    {autor.obras.length > 0 && (
      <div>
        <h2>Obras</h2>
        <ul>
          {autor.obras.map((o) => (
            <li>
              <a href={`/obra/${slugObra(autor.autor, o)}`}>{o}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {autor.partes.length > 0 && (
      <div>
        <h2>Partes citadas</h2>
        <ul>
          {autor.partes.map((p) => (
            <li>
              <a href={`/figura/${slugificar(p)}`}>{p}</a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {autor.en_dialogo_con.length > 0 && (
      <div>
        <h2>En diálogo con</h2>
        <ul style="display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; padding: 0;">
          {autor.en_dialogo_con.map((titulo) => (
            <li>
              <a href={`/buscar?q=${encodeURIComponent(titulo)}&tab=obras`} class="chip" style="text-decoration: none;">
                {titulo}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    <h2>Menciones</h2>
    <ul style="list-style: none; padding: 0; display: flex; flex-direction: column; gap: 1rem;">
      {autor.citas.map((c) => {
        const ep = index.eps.find((e) => e[0] === c.episodio_id);
        const enlace = ep ? enlaceYoutube(ep[6], c.inicio_s) : null;
        return (
          <li style="border-bottom: 1px solid var(--color-borde); padding-block: 0.75rem;">
            <p style="margin: 0 0 0.3rem; color: var(--color-texto-tenue); font-size: 0.85em;">
              <a href={`/episodio/${c.episodio_id}`}>{c.episodio_titulo}</a>
              {c.inicio_s != null && (
                <>
                  {" · "}
                  {enlace ? <a href={enlace} target="_blank" rel="noopener noreferrer">{minutoLegible(c.inicio_s)}</a> : minutoLegible(c.inicio_s)}
                </>
              )}
              {c.obra && (
                <>
                  {" · "}
                  <a href={`/obra/${slugObra(autor.autor, c.obra)}`}>{c.obra}</a>
                </>
              )}
              {c.parte && ` · ${c.parte}`}
              {c.tono && ` · ${c.tono}`}
            </p>
            {c.cita && <p style="margin: 0;">«{c.cita}»</p>}
            {c.contexto && <p style="margin: 0.3rem 0 0; color: var(--color-texto-tenue); font-size: 0.9em;">{c.contexto}</p>}
          </li>
        );
      })}
    </ul>
  </div>
</Base>
