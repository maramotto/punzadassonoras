---
import Base from "../layouts/Base.astro";
import BarraFiltros from "../components/BarraFiltros.tsx";
import GrafoDialogo from "../components/GrafoDialogo.tsx";
import MatrizAutorEpisodio from "../components/MatrizAutorEpisodio.tsx";
import MatrizTemasGrafico from "../components/MatrizTemasGrafico.tsx";
import RankingAutores from "../components/RankingAutores.tsx";
import AreaPorTipo from "../components/AreaPorTipo.tsx";
import TablaCondicional from "../components/TablaCondicional.tsx";
---

<Base
  titulo="Explorar"
  descripcion="Los gráficos de Punzadas Sonoras: matriz de temas, ranking de autorías, matriz de autoría, grafo de obras en diálogo y área por tipo, todos contra la misma barra de filtros."
>
  <div class="zona-titulo">
    <div class="envoltura" style="padding-block: 1.25rem 0.75rem;">
      <h1 style="margin: 0;">
        <img class="marca" src="/images/marca/explorar-letras.svg" alt="Explorar" style="height:1.5rem;" />
      </h1>
    </div>
  </div>
  <BarraFiltros client:load />
  <div class="envoltura" style="padding-block: 1.5rem;">
    <MatrizTemasGrafico client:visible />

    <RankingAutores client:visible />
    <MatrizAutorEpisodio client:visible />
    <GrafoDialogo client:only="react" />
    <AreaPorTipo client:visible />

    <h2 style="margin-top: 2rem;">Todas las menciones</h2>
    <p style="color: var(--color-texto-tenue);">
      El gemelo accesible de los gráficos de arriba: la misma porción de datos, en tabla.
    </p>
    <TablaCondicional client:load />
  </div>
</Base>
