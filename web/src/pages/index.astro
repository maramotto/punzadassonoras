---
import Base from "../layouts/Base.astro";
import MatrizTemasGrafico from "../components/MatrizTemasGrafico.tsx";
import { indexBuild } from "../lib/datosBuild";

const index = indexBuild();
---

<Base
  titulo="universopunzadas"
  descripcion="Catálogo navegable de las referencias culturales citadas en Punzadas Sonoras: qué se cita, quién lo cita y en qué episodio, con la cita literal y el minuto exacto."
>
  <section class="hero-home envoltura">
    <h1 class="hero-home__titulo">
      <img class="marca hero-home__wordmark" src="/images/marca/universo-punzadas-letras.svg" alt="universopunzadas" />
    </h1>
    <p class="hero-home__intro">
      Catálogo navegable de las referencias culturales citadas en <strong>Punzadas Sonoras</strong>: qué se
      cita, quién lo cita y en qué episodio, con la cita literal y el minuto exacto. {index.eps.length} episodios,
      {" "}{index.refs.length.toLocaleString("es")} menciones.
    </p>

    <div class="hero-home__accesos">
      <a href="/buscar" class="tarjeta-acceso">
        <span class="tarjeta-acceso__titulo">Buscador</span>
        <span class="tarjeta-acceso__desc">
          Texto libre, o filtra por temporada, autoría, tema, tipo, función y confianza.
        </span>
      </a>
      <a href="/explorar" class="tarjeta-acceso">
        <span class="tarjeta-acceso__titulo">Explorar</span>
        <span class="tarjeta-acceso__desc">
          Matrices, ranking de autorías y el grafo de obras en diálogo: el archivo visto de otra manera.
        </span>
      </a>
    </div>
  </section>

  <section class="envoltura seccion-home-matriz">
    <MatrizTemasGrafico client:visible />
  </section>
</Base>
