---
import Base from "../layouts/Base.astro";
import BarraFiltros from "../components/BarraFiltros.tsx";
import Buscador from "../components/Buscador.tsx";
---

<Base
  titulo="Buscar"
  descripcion="Busca por autora, obra o cita literal entre las menciones de Punzadas Sonoras, con tolerancia a erratas."
>
  <div class="envoltura" style="padding-top: 1.25rem;">
    <h1 style="margin: 0;">
      <img class="marca" src="/images/marca/buscador-referencias-letras.svg" alt="Buscador de referencias" style="height:1.5rem;" />
    </h1>
  </div>
  <BarraFiltros client:load />
  <Buscador client:load />
</Base>
